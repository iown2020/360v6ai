# 360V6 CPU 调频默认配置（cpufreq 服务读取并写入 sysfs）
# policy0 覆盖 4 个 Cortex-A53（共享同一调频策略）
# performance + 上限 1.2GHz：防原装老化电源过流锁死
# minfreq 864MHz 与 OPP 表中的最低档一致
config settings 'cpufreq'
	option governor0 'performance'
	option minfreq0 '864000'
	option maxfreq0 '1200000'

# set=1 表示已人工配置，cpufreq 包自带的 10-cpufreq 不再按平台默认改写为 schedutil
config settings 'global'
	option set '1'
