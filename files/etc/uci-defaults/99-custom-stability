#!/bin/sh
# ============================================================
# 360V6 (IPQ6000) 出厂自动加固脚本（首次开机 uci-defaults 执行）
# 目的: 根治原装老化电源过流锁死、ath11k WPA3-SAE/PMF 死锁
# ============================================================

# --- 1. CPU 调频（cpufreq 服务：performance + 上限 1.2GHz）---
# cpufreq 是持久化的 uci 配置 + 开机服务（START=15），锁频不再靠一次性写 sysfs。
# 包自带的 10-cpufreq 会按平台把 qualcommax 写成 schedutil，故置 global.set=1 跳过其默认值。
uci -q set cpufreq.cpufreq.governor0='performance'
uci -q set cpufreq.cpufreq.minfreq0='864000'
uci -q set cpufreq.cpufreq.maxfreq0='1200000'
uci -q set cpufreq.global.set='1'
uci -q commit cpufreq
/etc/init.d/cpufreq enable 2>/dev/null || true
echo "[加固] cpufreq 已设为 performance / 864MHz-1.2GHz"

# --- 2. Wi-Fi 默认配置 ---
# SSID: 2024 / 密码: 20242024 / 纯 WPA2-PSK / 关 PMF & SAE
[ -s /etc/config/wireless ] || wifi config >/dev/null 2>&1
for iface in $(uci show wireless 2>/dev/null | grep '=wifi-iface' | cut -d. -f2 | cut -d= -f1); do
    uci set wireless.${iface}.ssid='2024'
    uci set wireless.${iface}.encryption='psk2'
    uci set wireless.${iface}.key='20242024'
    uci set wireless.${iface}.ieee80211w='0'          # 关闭 PMF
    uci set wireless.${iface}.skip_inactivity_poll='1'
    uci set wireless.${iface}.disassoc_low_ack='0'
    uci set wireless.${iface}.wnm_sleep_mode='0'
    uci set wireless.${iface}.isolate='0'
done

# --- 3. 射频国家码与发射功率限制（防 FEM 功放过热失真）---
# 按 band 判定，不依赖 radio0/radio1 的枚举顺序（不同 DTS 下 phy 顺序可能相反，
# 原先写死 radio0=5G/radio1=2.4G 存在功率错配风险）
for dev in $(uci show wireless 2>/dev/null | grep '=wifi-device' | cut -d. -f2 | cut -d= -f1); do
    uci set wireless.${dev}.country='CN'
    band="$(uci -q get wireless.${dev}.band)"
    [ -n "$band" ] || band="$(uci -q get wireless.${dev}.hwmode)"
    case "$band" in
        2g|2.4g|11g|11b) uci set wireless.${dev}.txpower='20' ;;   # 2.4G: 20dBm (100mW)
        *)               uci set wireless.${dev}.txpower='23' ;;   # 5G: 23dBm (200mW)
    esac
done
uci commit wireless
echo "[加固] Wi-Fi SSID=2024 / 纯 WPA2-PSK / 5G 23dBm / 2.4G 20dBm"

# --- 4. 关闭 fw4 软件/硬件分流，让 NSS ECM 独占硬件加速 ---
uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q set firewall.@defaults[0].fullcone='0'
uci -q set firewall.@defaults[0].fullcone6='0'
uci -q commit firewall

uci -q set network.globals.packet_steering='0'
echo "[加固] fw4 分流/硬件分流/Packet Steering 已关闭（避让 NSS ECM）"

# --- 5. 关闭 PPPoE LCP 激进保活（原 5秒3次 易触发链路抖动重拨）---
uci -q delete network.wan.keepalive
uci -q commit network

# --- 6. 确保 NSS ECM 硬件流表引擎启用 ---
uci -q set ecm.global.acceleration_engine='auto'
uci -q set ecm.general.disable_offloads='0'
uci -q commit ecm
/etc/init.d/qca-nss-ecm enable 2>/dev/null || true
/etc/init.d/qca-nss-ecm restart 2>/dev/null || true
echo "[加固] NSS ECM 硬件流表已启用"

# --- 7. dnsmasq 双优化: 缓存限 2000 + Windows 连网探测防假死 ---
if [ "$(uci show dhcp 2>/dev/null | grep -c '@dnsmasq\[0\]')" -ge 1 ]; then
    uci set dhcp.@dnsmasq[0].cachesize='2000'
    uci add_list dhcp.@dnsmasq[0].rebind_domain='msftncsi.com'
    uci add_list dhcp.@dnsmasq[0].rebind_domain='ipv6.msftncsi.com'
    uci add_list dhcp.@dnsmasq[0].rebind_domain='ntp.org.cn'
    uci commit dhcp
fi

# --- 8. 内核调优 sysctl ---
# 同样由 /etc/init.d/custom-tune 每次开机执行（见文件末尾启用）

# --- 9. 默认 LuCI 主题 Aurora ---
# 主题包自带的 30_luci-theme-aurora 在 sysupgrade 保留配置时（PKG_UPGRADE=1）不执行，
# 这里无条件补一次，确保升级后界面仍是 Aurora
if [ -d /www/luci-static/aurora ]; then
    printf '%s\n' \
        "set luci.themes.Aurora='/luci-static/aurora'" \
        "set luci.main.mediaurlbase='/luci-static/aurora'" \
        "commit luci" | uci -q batch
    echo "[加固] 默认主题已设为 Aurora"
fi

# --- 10. zram 交换分区固定 256MB + LZ4 ---
# uci-defaults 早于 /etc/init.d/zram（START=15）执行，此处设置可生效
# 内核未编入 LZ4 时 zram.init 会自动回退 lzo，不会启动失败
uci -q set system.@system[0].zram_size_mb='256'
uci -q set system.@system[0].zram_comp_algo='lz4'
uci -q commit system
echo "[加固] zram 已设为 256MB / LZ4"

# --- 11. 启用开机运行时调优服务 ---
if [ -x /etc/init.d/custom-tune ]; then
    /etc/init.d/custom-tune enable
    echo "[加固] custom-tune 已启用（每次开机锁频 + irqbalance + sysctl）"
fi

echo "=== 360V6 出厂加固完成 ==="
exit 0
