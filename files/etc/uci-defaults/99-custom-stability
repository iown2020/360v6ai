#!/bin/sh
# ============================================================
# 360V6 (IPQ6000) 出厂自动加固脚本（首次开机 uci-defaults 执行）
# 目的: 根治原装老化电源过流锁死、ath11k WPA3-SAE/PMF 死锁
# ============================================================

# --- 1. CPU 锁频 1.2GHz（performance governor 零切换延迟，防高负载掉延迟）---
# performance 直接锁 max_freq，不像 schedutil 有 10-50ms ramp-up 延迟
# 频率上限 1.2GHz 是防原装电源过流锁死的硬限制
for cpu in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
    # 优先 performance（零延迟），回退 schedutil，再回退 available 第一个
    if echo performance > "${cpu}/scaling_governor" 2>/dev/null; then
        :
    elif echo schedutil > "${cpu}/scaling_governor" 2>/dev/null; then
        :
    else
        avail=$(cat "${cpu}/scaling_available_governors" 2>/dev/null | awk '{print $1}')
        [ -n "$avail" ] && echo "$avail" > "${cpu}/scaling_governor"
    fi
    echo 864000  > "${cpu}/scaling_min_freq" 2>/dev/null
    echo 1200000 > "${cpu}/scaling_max_freq" 2>/dev/null
done
echo "[加固] CPU 锁频 1.2GHz（performance governor）"

# --- 1.5 启动 irqbalance（网络中断分摊到多核，防高负载单核打爆）---
# 只在多核机器上生效；irqbalance 默认自动 daemonize，命令立刻返回不阻塞
CORES=$(grep -c ^processor /proc/cpuinfo 2>/dev/null || echo 1)
if [ "$CORES" -gt 1 ] && [ -x /usr/sbin/irqbalance ]; then
    irqbalance 2>/dev/null || true
    echo "[加固] irqbalance 已启动（${CORES} 核中断负载均衡）"
fi

# --- 2. Wi-Fi 默认配置 ---
# SSID: 2024 / 密码: 20242024 / 纯 WPA2-PSK / 关 PMF & SAE
[ -s /etc/config/wireless ] || wifi config >/dev/null 2>&1
for iface in $(uci show wireless 2>/dev/null | grep '=wifi-iface' | cut -d. -f2 | cut -d= -f1); do
    uci set wireless.${iface}.ssid='2024'
    uci set wireless.${iface}.encryption='psk2'
    uci set wireless.${iface}.key='20242024'
    uci set wireless.${iface}.ieee80211w='0'          # 关闭 PMF
    uci set wireless.${iface}.skip_inactivity_poll='1'
    uci set wireless.${iface}.disassoc_low_ack='0'
    uci set wireless.${iface}.wnm_sleep_mode='0'
    uci set wireless.${iface}.isolate='0'
done

# --- 3. 射频国家码与发射功率限制（防 FEM 功放过热失真）---
# radio0 = 5GHz, radio1 = 2.4GHz
uci set wireless.radio0.country='CN'
uci set wireless.radio0.txpower='23'                 # 5G: 23dBm (200mW)
uci set wireless.radio1.country='CN'
uci set wireless.radio1.txpower='20'                 # 2.4G: 20dBm (100mW)
uci commit wireless
echo "[加固] Wi-Fi SSID=2024 / 纯 WPA2-PSK / 5G 23dBm / 2.4G 20dBm"

# --- 4. 关闭 fw4 软件/硬件分流，让 NSS ECM 独占硬件加速 ---
uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q set firewall.@defaults[0].fullcone='0'
uci -q set firewall.@defaults[0].fullcone6='0'
uci -q commit firewall

uci -q set network.globals.packet_steering='0'
echo "[加固] fw4 分流/硬件分流/Packet Steering 已关闭（避让 NSS ECM）"

# --- 5. 关闭 PPPoE LCP 激进保活（原 5秒3次 易触发链路抖动重拨）---
uci -q delete network.wan.keepalive
uci -q commit network

# --- 6. 确保 NSS ECM 硬件流表引擎启用 ---
uci -q set ecm.global.acceleration_engine='auto'
uci -q set ecm.general.disable_offloads='0'
uci -q commit ecm
/etc/init.d/qca-nss-ecm enable 2>/dev/null || true
/etc/init.d/qca-nss-ecm restart 2>/dev/null || true
echo "[加固] NSS ECM 硬件流表已启用"

# --- 7. dnsmasq 双优化: 缓存限 2000 + Windows 连网探测防假死 ---
if [ "$(uci show dhcp 2>/dev/null | grep -c '@dnsmasq\[0\]')" -ge 1 ]; then
    uci set dhcp.@dnsmasq[0].cachesize='2000'
    uci add_list dhcp.@dnsmasq[0].rebind_domain='msftncsi.com'
    uci add_list dhcp.@dnsmasq[0].rebind_domain='ipv6.msftncsi.com'
    uci add_list dhcp.@dnsmasq[0].rebind_domain='ntp.org.cn'
    uci commit dhcp
fi

# --- 8. 加载内核调优 sysctl（内存保护 + 网络栈优化）---
if [ -d /etc/sysctl.d ]; then
    sysctl -p /etc/sysctl.d/*.conf 2>/dev/null || true
    echo "[加固] 内核调优已加载（swappiness=1 + backlog=4096 + TFO）"
fi

echo "=== 360V6 出厂加固完成 ==="
exit 0
