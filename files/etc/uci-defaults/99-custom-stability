#!/bin/sh
# ============================================================
# 360V6 (IPQ6000) 出厂自动加固脚本（首次开机 uci-defaults 执行）
# 目的: 根治原装老化电源过流锁死、ath11k WPA3-SAE/PMF 死锁
# ============================================================

# --- 1. CPU 调频（cpufreq 服务：performance + 上限 1.2GHz）---
# cpufreq 是持久化的 uci 配置 + 开机服务（START=15），锁频不再靠一次性写 sysfs。
# 包自带的 10-cpufreq 会按平台把 qualcommax 写成 schedutil，故置 global.set=1 跳过其默认值。
uci -q set cpufreq.cpufreq.governor0='performance'
uci -q set cpufreq.cpufreq.minfreq0='864000'
uci -q set cpufreq.cpufreq.maxfreq0='1200000'
uci -q set cpufreq.global.set='1'
uci -q commit cpufreq
/etc/init.d/cpufreq enable 2>/dev/null || true
echo "[加固] cpufreq 已设为 performance / 864MHz-1.2GHz"

# --- 2. Wi-Fi 默认配置 ---
# SSID: 2024 / 密码: 20242024 / 纯 WPA2-PSK / 关 PMF & SAE
[ -s /etc/config/wireless ] || wifi config >/dev/null 2>&1
for iface in $(uci show wireless 2>/dev/null | grep '=wifi-iface' | cut -d. -f2 | cut -d= -f1); do
    uci set wireless.${iface}.ssid='2024'
    uci set wireless.${iface}.encryption='psk2'
    uci set wireless.${iface}.key='20242024'
    uci set wireless.${iface}.ieee80211w='0'
    uci set wireless.${iface}.skip_inactivity_poll='1'
    uci set wireless.${iface}.disassoc_low_ack='0'
    uci set wireless.${iface}.wnm_sleep_mode='0'
    uci set wireless.${iface}.isolate='0'
done

# --- 3. 射频国家码/功率/信道/带宽（防 FEM 过热 + 稳空口效率）---
# 按 band 判定，不依赖 radio0/radio1 的枚举顺序（不同 DTS 下 phy 顺序可能相反）
for dev in $(uci show wireless 2>/dev/null | grep '=wifi-device' | cut -d. -f2 | cut -d= -f1); do
    uci set wireless.${dev}.country='CN'
    band="$(uci -q get wireless.${dev}.band)"
    [ -n "$band" ] || band="$(uci -q get wireless.${dev}.hwmode)"
    case "$band" in
        2g|2.4g|11g|11b)
            uci set wireless.${dev}.txpower='20'
            uci set wireless.${dev}.htmode='HE20'
            uci set wireless.${dev}.noscan='1'
            uci set wireless.${dev}.legacy_rates='0'
            uci set wireless.${dev}.channel='1'
            ;;
        *)
            uci set wireless.${dev}.txpower='23'
            uci set wireless.${dev}.htmode='HE80'
            uci set wireless.${dev}.noscan='1'
            uci set wireless.${dev}.channel='36'
            ;;
    esac
done
uci commit wireless
echo "[加固] Wi-Fi SSID=2024 / 纯 WPA2-PSK / 5G 23dBm HE80 ch36 / 2.4G 20dBm HE20 ch1"

# --- 4. 关闭 fw4 软件/硬件分流，让 NSS ECM 独占硬件加速 ---
uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q set firewall.@defaults[0].fullcone='0'
uci -q set firewall.@defaults[0].fullcone6='0'
uci -q commit firewall

uci -q set network.globals.packet_steering='0'
echo "[加固] fw4 分流/硬件分流/Packet Steering 已关闭（避让 NSS ECM）"

# --- 5. PPPoE LCP 温和保活 ---
# 原厂默认 5 秒 3 次过于激进，链路轻微抖动即触发重拨；
# 但完全删除 keepalive 会让链路假死只能靠重启恢复，这里取中间值
uci -q set network.wan.keepalive='10 5'
uci -q commit network
echo "[加固] PPPoE LCP 保活已改为 10s/5 次（温和重拨阈值）"

# --- 6. 确保 NSS ECM 硬件流表引擎启用 ---
uci -q set ecm.global.acceleration_engine='auto'
uci -q set ecm.general.disable_offloads='0'
uci -q commit ecm
/etc/init.d/qca-nss-ecm enable 2>/dev/null || true
/etc/init.d/qca-nss-ecm restart 2>/dev/null || true
echo "[加固] NSS ECM 硬件流表已启用"

# --- 7. DNS 加速（SmartDNS，UCI 模型 + 失败自动回滚）---
# 关键修正:
#   1. smartdns 的 init 脚本从 /etc/config/smartdns 生成运行配置，
#      手写 /etc/smartdns/smartdns.conf 不会被读取（上一版踩过这个坑）
#   2. 启动后验证 6053 是否真的在监听；失败就回滚 dnsmasq，绝不让 DNS 断
#   3. 只在验证通过后才把 dnsmasq 指向 SmartDNS

if [ -x /etc/init.d/smartdns ] && [ -f /usr/sbin/smartdns ]; then
    # 7a. 主配置
    if ! uci -q get smartdns.@smartdns[0] >/dev/null 2>&1; then
        uci add smartdns smartdns >/dev/null
        uci commit smartdns
    fi
    uci set smartdns.@smartdns[0].enabled='1'
    uci set smartdns.@smartdns[0].port='6053'
    uci set smartdns.@smartdns[0].auto_set_dnsmasq='1'
    uci set smartdns.@smartdns[0].tcp_server='1'
    uci set smartdns.@smartdns[0].ipv6_server='0'
    uci set smartdns.@smartdns[0].cache_size='8192'
    uci set smartdns.@smartdns[0].cache_persist='1'
    uci set smartdns.@smartdns[0].prefetch_domain='1'
    uci set smartdns.@smartdns[0].speed_check_mode='ping,tcp:443'

    # 7b. 上游 DNS（先清空旧的 server 段，避免重复叠加）
    while uci -q delete smartdns.@server[0]; do :; done

    uci add smartdns server >/dev/null
    uci set smartdns.@server[-1].enabled='1'
    uci set smartdns.@server[-1].name='aliyun'
    uci set smartdns.@server[-1].type='udp'
    uci set smartdns.@server[-1].ip='223.5.5.5'
    uci set smartdns.@server[-1].port='53'

    uci add smartdns server >/dev/null
    uci set smartdns.@server[-1].enabled='1'
    uci set smartdns.@server[-1].name='tencent'
    uci set smartdns.@server[-1].type='udp'
    uci set smartdns.@server[-1].ip='119.29.29.29'
    uci set smartdns.@server[-1].port='53'

    uci commit smartdns

    # 7c. 启动并验证（最多等 5 秒）
    /etc/init.d/smartdns enable 2>/dev/null || true
    /etc/init.d/smartdns restart 2>/dev/null || true
    DNS_OK=0
    for i in 1 2 3 4 5; do
        sleep 1
        if netstat -uln 2>/dev/null | grep -q ':6053'; then
            DNS_OK=1
            break
        fi
    done

    if [ "$DNS_OK" = "1" ]; then
        # 验证通过，才把 dnsmasq 指过去
        uci -q delete dhcp.@dnsmasq[0].server
        uci -q add_list dhcp.@dnsmasq[0].server='127.0.0.1#6053'
        uci -q set dhcp.@dnsmasq[0].noresolv='1'
        uci -q commit dhcp
        /etc/init.d/dnsmasq restart 2>/dev/null || true
        echo "[加固] SmartDNS 已启用: 127.0.0.1:6053（dnsmasq 转发）"
    else
        # 7d. 回滚：SmartDNS 没起来，恢复 dnsmasq 默认解析
        logger -t custom-stability "SmartDNS 未监听 6053，自动回滚 dnsmasq"
        uci set smartdns.@smartdns[0].enabled='0'
        uci commit smartdns
        /etc/init.d/smartdns stop 2>/dev/null || true
        /etc/init.d/smartdns disable 2>/dev/null || true

        uci -q delete dhcp.@dnsmasq[0].server
        uci -q set dhcp.@dnsmasq[0].noresolv='0'
        uci -q set dhcp.@dnsmasq[0].rebind_protection='1'
        uci -q set dhcp.@dnsmasq[0].domainneeded='1'
        uci -q commit dhcp
        /etc/init.d/dnsmasq restart 2>/dev/null || true
        echo "[加固][WARN] SmartDNS 启动失败，已回滚到默认 DNS"
    fi
else
    echo "[加固][WARN] 未检测到 SmartDNS，跳过 DNS 加速（dnsmasq 保持默认）"
fi

# 7e. dnsmasq 基础优化（与 SmartDNS 成败无关，始终安全）
if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
    uci -q set dhcp.@dnsmasq[0].cachesize='2000'
    for d in msftncsi.com ipv6.msftncsi.com ntp.org.cn; do
        uci -q get dhcp.@dnsmasq[0].rebind_domain 2>/dev/null | grep -qw "$d" || \
            uci -q add_list dhcp.@dnsmasq[0].rebind_domain="$d"
    done
    uci -q commit dhcp
fi

# --- 8. 内核调优 sysctl ---
# 同样由 /etc/init.d/custom-tune 每次开机执行（见文件末尾启用）

# --- 9. 默认 LuCI 主题 Aurora ---
# 主题包自带的 30_luci-theme-aurora 在 sysupgrade 保留配置时（PKG_UPGRADE=1）不执行，
# 这里无条件补一次，确保升级后界面仍是 Aurora
if [ -d /www/luci-static/aurora ]; then
    printf '%s\n' \
        "set luci.themes.Aurora='/luci-static/aurora'" \
        "set luci.main.mediaurlbase='/luci-static/aurora'" \
        "commit luci" | uci -q batch
    echo "[加固] 默认主题已设为 Aurora"
fi

# --- 10. zram 交换分区固定 256MB + LZ4 ---
# uci-defaults 早于 /etc/init.d/zram（START=15）执行，此处设置可生效
# 内核未编入 LZ4 时 zram.init 会自动回退 lzo，不会启动失败
uci -q set system.@system[0].zram_size_mb='256'
uci -q set system.@system[0].zram_comp_algo='lz4'
uci -q commit system
echo "[加固] zram 已设为 256MB / LZ4"

# --- 11. 启用开机运行时调优服务 ---
if [ -x /etc/init.d/custom-tune ]; then
    /etc/init.d/custom-tune enable
    echo "[加固] custom-tune 已启用（每次开机 irqbalance + sysctl + SmartDNS 守护）"
fi

echo "=== 360V6 出厂加固完成 ==="
exit 0
