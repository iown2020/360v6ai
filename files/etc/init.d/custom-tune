#!/bin/sh /etc/rc.common
# ============================================================
# 360V6 每次开机执行的运行时调优
# CPU 调频交给 cpufreq 服务（/etc/config/cpufreq：performance / 864MHz-1.2GHz），
# 这里处理 irqbalance、sysctl、SmartDNS 守护
# （uci-defaults 只运行一次，运行时状态必须每次开机重新应用）
# ============================================================
# START=99: 等 firewall / nf_conntrack / smartdns 都就绪
START=99

start() {
    # --- 网络中断负载均衡 ---
    CORES=$(grep -c ^processor /proc/cpuinfo 2>/dev/null || echo 1)
    if [ "$CORES" -gt 1 ] && [ -x /usr/sbin/irqbalance ]; then
        /etc/init.d/irqbalance restart 2>/dev/null || /usr/sbin/irqbalance 2>/dev/null || true
        logger -t custom-tune "irqbalance 已启动（${CORES} 核）"
    fi

    # --- 内核调优 ---
    # OpenWrt procd 不自动加载 /etc/sysctl.d，需手动 sysctl -p
    # 先确保 nf_conntrack 已加载，否则 net.netfilter.* 会被 sysctl 静默忽略
    if [ -d /etc/sysctl.d ]; then
        modprobe nf_conntrack 2>/dev/null || true
        OUT=$(sysctl -p /etc/sysctl.d/*.conf 2>&1) || true
        if [ -n "$OUT" ]; then
            logger -t custom-tune "sysctl: ${OUT}"
        fi
        logger -t custom-tune "内核调优已加载（BBR+fq / backlog=4096 / conntrack=65536 / TFO）"
    fi

    # --- SmartDNS 守护 ---
    # SmartDNS 启用了但 6053 没监听时，立即把 dnsmasq 恢复默认，
    # 保证任何情况下都不会因为 DNS 上游不存在而断网
    SD_ENABLED="$(uci -q get smartdns.@smartdns[0].enabled)"
    SD_PORT="$(uci -q get smartdns.@smartdns[0].port)"
    [ -n "$SD_PORT" ] || SD_PORT="6053"

    if [ "$SD_ENABLED" = "1" ]; then
        DNS_OK=0
        for i in 1 2 3 4 5; do
            sleep 1
            if netstat -uln 2>/dev/null | grep -q ":$SD_PORT"; then
                DNS_OK=1
                break
            fi
        done

        if [ "$DNS_OK" != "1" ]; then
            logger -t custom-tune "SmartDNS 未监听 $SD_PORT，恢复 dnsmasq 默认上游"
            uci -q delete dhcp.@dnsmasq[0].server
            uci -q set dhcp.@dnsmasq[0].noresolv='0'
            uci -q set dhcp.@dnsmasq[0].rebind_protection='1'
            uci -q set dhcp.@dnsmasq[0].domainneeded='1'
            uci -q commit dhcp
            /etc/init.d/dnsmasq restart 2>/dev/null || true
            /etc/init.d/smartdns restart 2>/dev/null || true
        fi
    fi
}
