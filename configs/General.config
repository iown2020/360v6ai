### ==============================================================
### 360V6 (RE-CS-02) OpenWRT NSS 固件 - 加固精简版
### 核心特性: OpenClash + EasyTier 2.4.5 组网 + NSS 硬件加速
### 加固: CPU 1.2GHz锁频 / WPA2-PSK纯协议 / 射频功率保护
### ==============================================================

CONFIG_DEVEL=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -march=armv8-a+crypto+crc -mcpu=cortex-a53+crypto+crc -mtune=cortex-a53"
CONFIG_CCACHE=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# --- ZRAM 交换分区（512MB 内存，LZ4 压缩）---
# kmod-zram 必须显式选中：KERNEL_ZRAM_* 符号定义在 other.mk 的
# "if PACKAGE_kmod-zram" 里，仅靠 zram-swap 的 select 传递在 defconfig 时可能失效
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lz4=y
# 这两个是 OpenWrt 顶层符号（other.mk 定义），编译时经 kernel-defaults.mk
# 的 awk 去掉 KERNEL_ 前缀，转成内核 CONFIG_ZRAM_BACKEND_LZ4 / CONFIG_ZRAM_DEF_COMP_LZ4
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

# --- 基础系统工具 ---
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_irqbalance=y

# --- CPU 调频（cpufreq 服务：performance / 864MHz-1.2GHz，LuCI 可调）---
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_luci-app-cpufreq=y

# --- LuCI 管理界面 ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-ttyd=y

# --- 主题 ---
CONFIG_PACKAGE_luci-theme-aurora=y

# --- IPv6 支持 ---
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_dnsmasq-full=y

# --- OpenClash 科学上网（依赖由 Makefile 自动拉取）---
CONFIG_PACKAGE_luci-app-openclash=y

# --- EasyTier 2.4.5 内网组网 ---
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y

# --- TLS/诊断依赖（OpenClash 等需要）---
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-inet-diag=y

# --- USB 存储（U盘挂载）---
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-msdos=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockdev=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_mount-utils=y

# --- Samba4 局域网共享 ---
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y

# --- 实用工具（网络唤醒 / 定时重启 / 硬件状态显示）---
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_autocore=y

# --- UPnP 端口自动映射 ---
CONFIG_PACKAGE_luci-app-upnp=y

# --- 显式禁用不需要的包 ---
# 下载类（用户要求移除）
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_PACKAGE_ariang is not set
# CONFIG_PACKAGE_amule is not set

# SQM队列管理（与NSS硬件加速存在兼容取舍）
# CONFIG_PACKAGE_sqm-scripts-nss is not set
# CONFIG_PACKAGE_sqm-scripts is not set
# CONFIG_PACKAGE_luci-app-sqm is not set

# DDNS/WireGuard（OpenClash用户日常用不到，按精简原则移除）
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set

# 非必需capabilities/iptables扩展
# CONFIG_PACKAGE_libcap is not set
# CONFIG_PACKAGE_libcap-bin is not set
# CONFIG_PACKAGE_iptables-mod-extra is not set

# F2FS 文件系统（U盘用ext4/vfat即可）
# CONFIG_PACKAGE_kmod-fs-f2fs is not set
# CONFIG_PACKAGE_f2fs-tools is not set
# CONFIG_PACKAGE_f2fsck is not set
# CONFIG_PACKAGE_mkf2fs is not set
# CONFIG_PACKAGE_libf2fs6 is not set

# 未使用的VPN隧道/协议
# CONFIG_PACKAGE_kmod-pptp is not set
# CONFIG_PACKAGE_kmod-pppol2tp is not set
# CONFIG_PACKAGE_kmod-l2tp is not set
# CONFIG_PACKAGE_kmod-gre is not set
# CONFIG_PACKAGE_kmod-gre6 is not set
# CONFIG_PACKAGE_kmod-ip6-tunnel is not set
# CONFIG_PACKAGE_kmod-sit is not set
# CONFIG_PACKAGE_kmod-vxlan is not set
# CONFIG_PACKAGE_6rd is not set

# 网络测试/bonding等不需要的内核模块
# CONFIG_PACKAGE_kmod-net-selftests is not set
# CONFIG_PACKAGE_kmod-nat46 is not set
# CONFIG_PACKAGE_kmod-bonding is not set
# CONFIG_PACKAGE_kmod-macvlan is not set
# CONFIG_PACKAGE_kmod-slhc is not set

# 其他多余包
# CONFIG_PACKAGE_3proxy is not set
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
